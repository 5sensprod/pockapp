<?php

/**
 * Exemple de configuration de la couche distante — ticket 5.
 *
 * À copier en `config.php` DANS CE MÊME DOSSIER, sur le serveur, et à remplir.
 * `config.php` n'est pas versionné (voir server/.gitignore) : aucune clé ne
 * doit revenir dans ce fichier-ci.
 *
 * Modèle repris du mini-SaaS pocketapp.5sensprod.com : la configuration vit
 * hors dépôt, un exemple versionné à côté.
 */

return [
    /**
     * Clé attendue dans l'en-tête `X-API-Key`.
     *
     * Longue et aléatoire. Rien ne la dérive, rien ne la fait tourner
     * automatiquement : la changer, c'est éditer ce fichier et le champ
     * correspondant côté PocketApp.
     *
     * Pour en produire une :
     *   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
     *
     * Le script refuse de démarrer sous 16 caractères.
     */
    'api_key' => 'REMPLACER-PAR-UNE-CLE-ALEATOIRE-DE-64-CARACTERES',

    /**
     * Chemin ABSOLU du fichier publié, côté système de fichiers.
     *
     * Il doit correspondre à l'URL du contrat, https://axemusique.shop/data/menu.json
     * (05-contrat-menu.md §1). Le fichier temporaire est créé dans le même
     * répertoire, sans quoi le renommage ne serait plus atomique.
     *
     * Le répertoire doit exister et être inscriptible par PHP.
     */
    'target_file' => '/home/CHANGEME/public_html/data/menu.json',

    /**
     * Taille maximale du corps accepté, en octets. 256 Kio par défaut.
     *
     * Le contrat (§7) laissait la valeur à fixer sur mesure réelle ; faute de
     * mesure, on s'aligne sur le seuil indicatif de §4.5 de l'audit — quelques
     * centaines de kilo-octets sont le signe qu'il faut passer à l'option C,
     * pas une taille à absorber en silence. Un menu de navigation en fait
     * quelques kilo-octets.
     */
    'max_body_bytes' => 262144,

    /**
     * Cibles NOMMÉES supplémentaires pour la publication du menu.
     *
     * `publish-menu.php?target=<nom>` écrit dans le fichier correspondant, au
     * lieu de `target_file`. Le nom est une clé de ce tableau, JAMAIS un
     * chemin : rien de ce que l'appelant envoie n'entre dans un chemin de
     * fichier, et un nom inconnu est refusé plutôt que ramené à la cible
     * principale.
     *
     * Sert à raccorder le menu au catalogue sans toucher au menu en
     * production. Le site en développement lit ce fichier via
     * `VITE_PUBLISHED_MENU_URL=/data/menu-dev.json`.
     *
     * Laisser vide en production si aucun essai n'est en cours.
     */
    'targets' => [
        'dev' => __DIR__ . '/../../data/menu-dev.json',
    ],

    /**
     * Versions de `contractVersion` que ce script sait écrire.
     *
     * Toute autre valeur est REFUSÉE, jamais interprétée au mieux (§5 du
     * contrat). Ajouter `2` ici sans avoir relu les validations reviendrait à
     * publier un document non vérifié.
     */
    'supported_contract_versions' => [1],

    // ── Export du catalogue vers la base SQL ────────────────────────────────
    // Lu par api/products-sync.php uniquement. Contrat :
    // frontend/modules/site/PocketSite-docs/12-contrat-catalogue.md

    /**
     * Clé attendue par l'endpoint d'export du catalogue.
     *
     * DISTINCTE de `api_key` ci-dessus, et volontairement : celle-là autorise
     * à publier un menu de quelques kilo-octets, celle-ci à écrire dans la
     * base de données du catalogue. Deux portées, deux durées de vie ;
     * révoquer l'une ne doit pas condamner l'autre.
     *
     *   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
     */
    'catalog_api_key' => 'REMPLACER-PAR-UNE-AUTRE-CLE-ALEATOIRE',

    /**
     * Accès MySQL du mutualisé. Les mêmes identifiants que WordPress
     * fonctionneraient ; en prendre de dédiés, restreints à la base du
     * catalogue, évite qu'une clé d'export donne la main sur wp_users.
     */
    'db' => [
        'host' => 'localhost',
        'name' => 'CHANGEME',
        'user' => 'CHANGEME',
        'pass' => 'CHANGEME',
    ],

    /**
     * Préfixe des tables, tel que créé par server/sql/schema.sql.
     * Contraint à [A-Za-z0-9_] : il entre dans des noms de table, donc dans du
     * SQL non paramétrable.
     */
    'table_prefix' => 'ax_',

    /**
     * Plafonds d'un lot d'export — §6 du contrat. Le découpage est fait côté
     * PocketApp ; ces valeurs sont le garde-fou, pas la consigne.
     */
    'max_entities_per_batch' => 200,

    // ── Miroir des images ───────────────────────────────────────────────────
    // Lu par api/images-sync.php uniquement. Mécanisme :
    // frontend/modules/site/PocketSite-docs/16-conception-images.md
    //
    // La CLÉ est `catalog_api_key` ci-dessus : même base, même portée
    // d'écriture. En créer une seconde donnerait deux secrets à révoquer
    // ensemble, donc une occasion de plus d'en oublier un.

    /**
     * Racine des octets, chemin ABSOLU côté système de fichiers.
     *
     * Sous la racine web : les images y sont servies directement par Apache,
     * sans passer par PHP. L'arborescence est
     * `<media_root>/<brands|categories>/<legacy_id>/<rang>.<ext>` — nommée par
     * `legacy_id`, jamais par l'identifiant PocketBase, qui est régénéré à
     * chaque rechargement par purge (§4.1 de la conception).
     *
     * ⚠️ Tout ce qui s'écrit ici est servi par Apache. C'est pourquoi
     * images-sync.php n'accepte qu'une liste FERMÉE d'extensions et ne laisse
     * aucun nom venu du client toucher le disque.
     *
     * Le répertoire doit exister et être inscriptible par PHP.
     */
    'media_root' => '/home/CHANGEME/public_html/media/catalog',

    /**
     * Préfixe d'URL publique correspondant à `media_root`.
     *
     * Il ne sert PAS à écrire : il est renvoyé, pour que PocketApp sache sous
     * quelle URL l'image sera lisible. La ligne SQL, elle, ne porte que le
     * chemin RELATIF (`image_paths`).
     *
     * §6.5 de la conception est tranché depuis le 19 août 2026 : `catalog.php`
     * rend au bundle une URL COMPLÈTE, qu'il compose ici même à partir de ce
     * préfixe. Le bundle ne le connaît donc pas, et n'a pas à être rebâti si
     * les médias déménagent.
     */
    'media_base_url' => 'https://axemusique.shop/media/catalog/',

    /**
     * Plafond d'UN fichier, en octets. Sans rapport avec
     * `catalog_max_body_bytes`, qui vaut 1 Mio et plafonne un lot d'ENTITÉS :
     * une seule image de catégorie pèse 1 Mo en moyenne et 2,7 Mo au pire
     * (mesuré le 19 août 2026).
     *
     * Les plafonds PHP de l'hébergeur — `post_max_size`,
     * `upload_max_filesize` — ne sont PAS mesurés et peuvent être plus
     * serrés : dans ce cas c'est eux qui refusent, et images-sync.php le dit
     * explicitement plutôt que de rendre « erreur 1 ».
     */
    'image_max_bytes' => 8388608,

    /**
     * Journal, best-effort. `null` pour ne rien écrire.
     *
     * Une ligne par requête refusée ou publiée. À placer HORS de la racine web,
     * ou dans un dossier interdit en lecture HTTP : il ne contient pas la clé,
     * mais il dit quand et quoi on publie.
     */
    'log_file' => null,
];
