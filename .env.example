# Copier ce fichier en `.env` à la racine et y mettre les valeurs réelles.
# `.env` est ignoré par Git (.gitignore:4) — aucun secret ne doit revenir ici.

# backend/.env.example
GO_ENV=development
PORT=8090
VITE_DEV_URL=http://localhost:5173

# frontend/.env.example
VITE_BACKEND_URL=http://localhost:8090

# URL d'AppPos, lue par frontend/lib/apppos/apppos-config.ts:7.
# Absente, le code retombe sur http://127.0.0.1:3000 sous Wails.
VITE_APPPOS_URL=http://127.0.0.1:3000

# frontend/.env.production
# VITE_BACKEND_URL=/api

# ---------------------------------------------------------------------------
# `pnpm typegen` — identifiants admin PocketBase
# ---------------------------------------------------------------------------
# Lus par `pocketbase-typegen --env` (mécanisme natif de l'outil, via dotenv).
# Ils portaient auparavant en clair dans le script `typegen` de package.json.
# PocketBase doit être démarré pour que la commande aboutisse.
PB_TYPEGEN_URL=http://127.0.0.1:8090
PB_TYPEGEN_EMAIL=
PB_TYPEGEN_PASSWORD=
